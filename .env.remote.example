# Tip: run `rdk setup` once and the whole "VPS + proxy" section below moves into
# ~/.config/rdk/config — every project inherits it, and `rdk init` scaffolds only
# the per-project lines. `rdk config` shows the effective merged result.

# ── Per-project — YOU MUST SET THESE for each app ───────────────────────
PROJECT_NAME=myapp
APP_HOST=myapp.dev.wavedidwhat.com
APP_PORT=8000
APP_SERVICE=app                      # primary service name (django stack: "django")

# Which stack to run:
#   docker-compose.remote.yml     → generic single web service (any language, needs ./Dockerfile)
#   docker-compose.remote-db.yml  → the same, plus Postgres + Redis
#   docker-compose.django.yml     → full Cookiecutter-Django stack (+postgres/redis/mailpit/celery/flower)
COMPOSE_FILE=docker-compose.remote.yml

# Generic build input (used by docker-compose.remote.yml)
APP_DOCKERFILE=./Dockerfile

# ── VPS + proxy — same for all your projects (or save once: rdk setup) ──
# rdk refuses to run with the placeholders below left in — they fail at cert
# issuance, minutes after you could have known.
VPS_SSH=youruser@YOUR_VPS_IP

# Proxy mode — pick ONE (rdk connect / rdk doctor detect what the VPS runs):
#   Bare VPS (kit runs Traefik):  PROXY_NETWORK=web   + run `rdk proxy up` once
#   Existing Coolify/Traefik:     PROXY_NETWORK=coolify + skip `rdk proxy`
PROXY_NETWORK=web
ACME_EMAIL=you@example.com          # for Let's Encrypt (bare-VPS/Traefik mode)

# ── Defaults — leave these alone unless you know why ────────────────────
CERT_RESOLVER=letsencrypt
CERT_ENTRYPOINT=https
# HTTP_ENTRYPOINT=http              # the proxy's :80 entrypoint (http→https redirect)

# ── Time-limited deployments (optional) ─────────────────────────────────
# Stop this project automatically after a while, so a dev box doesn't collect
# a dozen forgotten stacks. Volumes are KEPT — expiry stops, it never destroys.
# Needs the reaper running once per server:  rdk reaper up
#   TTL=4h            # 90m | 4h | 2d. Empty/absent = runs until you stop it.
#   TTL_PROMPT=10m    # client-side warning lead time (VS Code); 0 disables
TTL=
TTL_PROMPT=10m

# ── Generic + DB stack only (docker-compose.remote-db.yml) ──────────────
# REDIS_PASSWORD is REQUIRED by this stack — Redis refuses to boot without it.
# Point your app's DB/cache hosts at the aliases ${PROJECT_NAME}-postgres / ${PROJECT_NAME}-redis.
REDIS_PASSWORD=change-me
APP_ENV_FILE=./.env.remote.app     # your app's runtime env (secrets)
DB_ENV_FILE=./.env.remote.db       # POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
POSTGRES_IMAGE=postgres:18-alpine  # override for postgis, pgvector, …
REDIS_IMAGE=redis:7-alpine

# ── Django stack only (docker-compose.django.yml) ───────────────────────
MAIL_HOST=mail.myapp.dev.wavedidwhat.com
FLOWER_HOST=flower.myapp.dev.wavedidwhat.com
DJANGO_DOCKERFILE=./compose/local/django/Dockerfile
POSTGRES_DOCKERFILE=./compose/production/postgres/Dockerfile
APP_ENV_FILE=./.envs/.local/.django
DB_ENV_FILE=./.envs/.local/.postgres
