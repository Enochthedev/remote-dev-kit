# ── Per-project (change these for each app) ─────────────────────────────
PROJECT_NAME=honeybyte
APP_HOST=honeybyte.dev.wavedidwhat.com
APP_PORT=8000
MAIL_HOST=mail.honeybyte.dev.wavedidwhat.com
FLOWER_HOST=flower.honeybyte.dev.wavedidwhat.com

# ── VPS + proxy (set once, rarely changes across projects) ──────────────
VPS_SSH=youruser@75.119.134.107
PROXY_NETWORK=coolify
CERT_RESOLVER=letsencrypt
CERT_ENTRYPOINT=https

# ── Build inputs (override only if your repo layout differs) ────────────
APP_DOCKERFILE=./compose/local/django/Dockerfile
POSTGRES_DOCKERFILE=./compose/production/postgres/Dockerfile
APP_ENV_FILE=./.envs/.local/.django
DB_ENV_FILE=./.envs/.local/.postgres
