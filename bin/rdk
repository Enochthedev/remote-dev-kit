#!/usr/bin/env bash
# rdk — global Remote Dev Kit CLI. Install once, run in any project folder.
# Stacks are bundled centrally ($RDK_HOME/stacks); the only per-project file is .env.remote.
set -euo pipefail

# --- locate bundled stacks -------------------------------------------------
RDK_HOME="${RDK_HOME:-$HOME/.remote-dev-kit}"
STACKS="$RDK_HOME/stacks"
if [ ! -d "$STACKS" ]; then
  self="$(cd "$(dirname "$0")" && pwd)"
  [ -d "$self/../stacks" ] && STACKS="$(cd "$self/../stacks" && pwd)"
fi
[ -d "$STACKS" ] || { echo "❌ can't find bundled stacks (set RDK_HOME)"; exit 1; }

ENV_FILE="${RDK_ENV_FILE:-.env.remote}"
cmd="${1:-}"; [ $# -gt 0 ] && shift || true

_usage() {
  cat <<'EOF'
rdk — Remote Dev Kit (global). Run inside any project folder.

usage: rdk <command>
  init         scaffold .env.remote here (the only per-project file)
  connect      create the docker context for this project (once)
  proxy up     bare VPS only: start Traefik (once per server)
  reaper up    start the TTL reaper (once per server, any VPS)
  up [--ttl D] build on the VPS + deploy (optionally expiring after D)
  watch        deploy + live-sync edits (hot reload)
  down         destroy (images + volumes)
  stop         stop containers (keep data)
  ttl [D|off]  show, set, or clear this project's expiry
  extend <D>   push the expiry out by D from now
  logs [svc]   follow logs
  ps           list this project's services
  vps          list EVERYTHING running on the VPS (all projects)
  manage <..>  run manage.py (django stack)
  sh           shell into the app container
  doctor       check prerequisites (docker, SSH, context)
  audit        security audit of this deployment (TLS, headers, debug, ports)

  D is a duration: 90m, 4h, 2d
EOF
}
case "$cmd" in ''|help|-h|--help) _usage; exit 0 ;; esac

# --- init: scaffold the only per-project file ------------------------------
if [ "$cmd" = "init" ]; then
  if [ -f "$ENV_FILE" ]; then
    echo "ℹ️  $ENV_FILE already exists"
  else
    proj="$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g')"

    # If you already have a compose file, use it. RDK layers its traefik labels on top rather
    # than shipping a rival definition of your own stack.
    _own=""
    for _f in compose.yaml compose.yml docker-compose.yml docker-compose.yaml docker-compose.local.yml; do
      [ -f "$_f" ] && { _own="$_f"; break; }
    done

    {
      echo "# Per-project config — the ONLY file rdk needs in your repo."
      echo "PROJECT_NAME=${proj}"
      echo "APP_HOST=${proj}.dev.example.com"
      echo "APP_PORT=8000"
      echo ""
      if [ -n "$_own" ]; then
        echo "# Your compose file is the source of truth. RDK adds only the proxy network and"
        echo "# the traefik labels on APP_SERVICE — it does not redefine your services."
        echo "BASE_COMPOSE=${_own}"
        echo "APP_SERVICE=                             # <- which of your services faces the web"
      else
        echo "# No compose file here, so RDK builds a single web service from your Dockerfile."
        echo "COMPOSE_FILE=docker-compose.remote.yml   # or docker-compose.remote-db.yml / .django.yml"
        echo "APP_DOCKERFILE=./Dockerfile"
      fi
      echo ""
      echo "VPS_SSH=youruser@YOUR_VPS_IP"
      echo "PROXY_NETWORK=web                        # 'web' (bare VPS) or 'coolify'"
      echo "ACME_EMAIL=you@example.com               # bare-VPS/Traefik mode"
      echo "CERT_RESOLVER=letsencrypt"
      echo "CERT_ENTRYPOINT=https"
      echo ""
      echo "# TTL=4h                                 # optional: stop automatically after this long"
    } > "$ENV_FILE"

    [ -n "$_own" ] && echo "🧩 found $_own — using it as the base, RDK will only add the proxy + TLS labels"
    # Keep secrets (SSH target, creds) out of git.
    if git rev-parse --git-dir >/dev/null 2>&1; then
      if [ -f .gitignore ] && ! grep -qxF "$ENV_FILE" .gitignore; then printf '\n%s\n' "$ENV_FILE" >> .gitignore
      elif [ ! -f .gitignore ]; then echo "$ENV_FILE" > .gitignore; fi
      echo "🔒 added $ENV_FILE to .gitignore"
    fi
    echo "✅ wrote $ENV_FILE — edit it, then:  rdk connect && rdk up"
  fi
  exit 0
fi

# --- everything else needs config ------------------------------------------
[ -f "$ENV_FILE" ] || { echo "❌ no $ENV_FILE here. Run:  rdk init"; exit 1; }
# Safe loader: parse KEY=VALUE only — never `source` (a crafted .env.remote must not run code).
_rdk_load() {
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [ "${line#*=}" = "$line" ] && continue
    key="${line%%=*}"; val="${line#*=}"
    key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
    case "$key" in ''|*[!A-Za-z0-9_]*) continue ;; esac
    # never let a config file hijack the shell/loader environment
    case "$key" in PATH|IFS|ENV|BASH_ENV|SHELLOPTS|PS4|PROMPT_COMMAND|LD_*|DYLD_*|BASH_FUNC_*) continue ;; esac
    val="${val%%[[:space:]]#*}"                       # strip inline comment
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"  # trim
    case "$val" in \"*\") val="${val#\"}"; val="${val%\"}" ;; \'*\') val="${val#\'}"; val="${val%\'}" ;; esac
    export "$key=$val"
  done < "$ENV_FILE"
}
_rdk_load
: "${PROJECT_NAME:?set PROJECT_NAME in $ENV_FILE}"
: "${VPS_SSH:?set VPS_SSH in $ENV_FILE}"

CTX="remote-${PROJECT_NAME}"
STACK_FILE="$STACKS/${COMPOSE_FILE:-docker-compose.remote.yml}"
# The primary service differs per stack — the django stack calls it `django`, the
# generic one calls it `app`. Derive it from the stack instead of making people
# remember: a wrong APP_SERVICE only surfaces later, as `rdk manage` / `rdk sh`
# failing with "no such service".
case "${COMPOSE_FILE:-}" in
  *django*) _default_service="django" ;;
  *)        _default_service="app" ;;
esac
# Remember whether the user actually chose one. In overlay mode the stack-derived default
# ("app"/"django") is just a guess at someone else's compose file, and the error message
# should say so rather than blaming a value they never set.
APP_SERVICE_SET="${APP_SERVICE:-}"
APP_SERVICE="${APP_SERVICE:-$_default_service}"
ROOT="$(pwd)"

# --- overlay mode ----------------------------------------------------------
# If the project has its OWN compose file, that file is the source of truth and RDK adds only
# what is actually its business: the proxy network, and the traefik labels on the one
# web-facing service. RDK stops re-implementing your stack.
#
# The alternative — shipping a compose file per framework — is a fork of your compose file that
# rots the moment upstream changes, and it never ends (rails+postgres, next+redis, laravel+mysql…).
#
# Opt-in via BASE_COMPOSE, so existing COMPOSE_FILE deployments keep running byte-for-byte.

# Files we recognise as "your own compose", in precedence order.
_BASE_CANDIDATES="compose.yaml compose.yml docker-compose.yml docker-compose.yaml docker-compose.local.yml"

_detect_base() {
  local f
  for f in $_BASE_CANDIDATES; do
    [ -f "$ROOT/$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

# Compose forbids variable interpolation in service KEYS (`${APP_SERVICE}:` is rejected), so the
# overlay cannot be a static shipped file — it has to be rendered with the real service name.
# We bake every value in here rather than leaning on compose interpolation: fewer escaping traps.
_render_overlay() {
  local out="$1" base_has_develop="$2"
  mkdir -p "$(dirname "$out")"
  {
    echo "# Generated by rdk — do not edit. Your compose file stays the source of truth."
    echo "networks:"
    echo "  proxy:"
    echo "    external: true"
    echo "    name: ${PROXY_NETWORK:-coolify}"
    echo ""
    echo "services:"
    echo "  ${APP_SERVICE}:"
    echo "    networks: [default, proxy]"
    echo "    labels:"
    echo "      - traefik.enable=true"
    echo "      - traefik.docker.network=${PROXY_NETWORK:-coolify}"
    echo "      - traefik.http.routers.${PROJECT_NAME}-web.rule=Host(\`${APP_HOST}\`)"
    echo "      - traefik.http.routers.${PROJECT_NAME}-web.entrypoints=${CERT_ENTRYPOINT:-https}"
    echo "      - traefik.http.routers.${PROJECT_NAME}-web.tls.certresolver=${CERT_RESOLVER:-letsencrypt}"
    echo "      - traefik.http.services.${PROJECT_NAME}-web.loadbalancer.server.port=${APP_PORT:-8000}"

    # Only add hot-reload sync if the author hasn't written their own. Compose appends
    # sequences on merge, so duplicating `develop.watch` would double every sync rule.
    if [ "$base_has_develop" != "yes" ]; then
      echo "    develop:"
      echo "      watch:"
      echo "        - action: sync"
      echo "          path: ."
      echo "          target: /app"
      echo "          ignore: [.git/, .venv/, node_modules/, __pycache__/, '*.pyc']"
    fi
  } > "$out"
}

BASE_COMPOSE="${BASE_COMPOSE:-}"
COMPOSE_FILES=()
BASE_FILES=()

if [ -n "$BASE_COMPOSE" ]; then
  # APP_SERVICE can't be guessed in overlay mode — it's whichever of YOUR services faces the web.
  # Fail now with the list, rather than later with an opaque "no such service".
  _bad_service=0
  case ",${BASE_COMPOSE}," in *,,*) ;; esac
  IFS=',' read -r -a _bases <<< "$BASE_COMPOSE"
  for _b in "${_bases[@]}"; do
    _b="${_b#"${_b%%[![:space:]]*}"}"; _b="${_b%"${_b##*[![:space:]]}"}"
    [ -f "$ROOT/$_b" ] || { echo "❌ BASE_COMPOSE points at '$_b', which doesn't exist here"; exit 1; }
    COMPOSE_FILES+=(-f "$ROOT/$_b")
    BASE_FILES+=(-f "$ROOT/$_b")
  done

  _base_has_develop=no
  grep -qE '^[[:space:]]+develop:' "$ROOT/${_bases[0]}" 2>/dev/null && _base_has_develop=yes

  OVERLAY="${XDG_CACHE_HOME:-$HOME/.cache}/rdk/${PROJECT_NAME}/overlay.yml"
  _render_overlay "$OVERLAY" "$_base_has_develop"
  COMPOSE_FILES+=(-f "$OVERLAY")
else
  COMPOSE_FILES=(-f "$STACK_FILE")
fi

COMPOSE=(docker --context "$CTX" compose -p "$PROJECT_NAME" --project-directory "$ROOT" --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}")

# In overlay mode a wrong APP_SERVICE is the single most likely misconfiguration, and compose's
# own error for it is unhelpful. Check it up front, and show what's actually available.
# Ask the BASE files what services exist — never the merged project. A wrong APP_SERVICE makes
# the overlay define a service with no image and no build, which makes the whole project invalid;
# validating the merged result would just fail for that reason and tell the user nothing useful.
_base_services() {
  docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" "${BASE_FILES[@]}" config --services 2>/dev/null || true
}

_check_app_service() {
  [ -n "$BASE_COMPOSE" ] || return 0
  local svcs
  svcs="$(_base_services)"
  [ -z "$svcs" ] && return 0
  printf '%s\n' "$svcs" | grep -qxF "$APP_SERVICE" && return 0

  if [ -z "$APP_SERVICE_SET" ]; then
    echo "❌ APP_SERVICE isn't set, and RDK can't guess which of your services faces the web."
  else
    echo "❌ APP_SERVICE='$APP_SERVICE' is not a service in $BASE_COMPOSE."
  fi
  echo "   Set it in $ENV_FILE to one of:"
  printf '     %s\n' $svcs
  exit 1
}

# --- TTL: time-limited deployments -----------------------------------------
# Expiry is a file on the VPS (/var/lib/rdk/ttl/<project>), not a container label: labels are
# immutable on a running container, so `rdk extend` would otherwise have to RECREATE your
# containers just to tell them to live longer. The reaper enforces it; see stacks/reaper.yml.
TTL_DIR="/var/lib/rdk/ttl"
TTL_FILE="$TTL_DIR/$PROJECT_NAME"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)

# "90m" | "4h" | "2d" -> seconds
_ttl_secs() {
  local d="$1" n u
  n="${d%[smhd]}"; u="${d##*[0-9]}"
  case "$n" in ''|*[!0-9]*) echo "❌ bad duration '$d' (try 90m, 4h, 2d)" >&2; return 1 ;; esac
  case "$u" in
    s) echo $(( n )) ;;
    m|'') echo $(( n * 60 )) ;;
    h) echo $(( n * 3600 )) ;;
    d) echo $(( n * 86400 )) ;;
    *) echo "❌ bad duration unit '$u' (use s, m, h, d)" >&2; return 1 ;;
  esac
}

_fmt_left() {
  local s="$1"
  [ "$s" -le 0 ] && { echo "expired"; return; }
  local d=$(( s / 86400 )) h=$(( (s % 86400) / 3600 )) m=$(( (s % 3600) / 60 ))
  [ "$d" -gt 0 ] && { echo "${d}d ${h}h"; return; }
  [ "$h" -gt 0 ] && { echo "${h}h ${m}m"; return; }
  echo "${m}m"
}

# Compute expiry on the VPS clock. Using the Mac's clock would let a few minutes of skew kill
# a deployment early — and the reaper compares against VPS time.
_ttl_set() {
  local secs="$1" exp
  exp=$(ssh "${SSH_OPTS[@]}" "$VPS_SSH" \
    "mkdir -p $TTL_DIR && exp=\$(( \$(date +%s) + $secs )) && echo \$exp > '$TTL_FILE' && echo \$exp") || {
      echo "❌ couldn't write the TTL on $VPS_SSH" >&2; return 1; }
  echo "$exp"
}

_ttl_get() {
  ssh "${SSH_OPTS[@]}" "$VPS_SSH" "cat '$TTL_FILE' 2>/dev/null || true" | tr -dc '0-9'
}

_ttl_clear() {
  ssh "${SSH_OPTS[@]}" "$VPS_SSH" "rm -f '$TTL_FILE'"
}

# Is the reaper actually running? A TTL nobody enforces is worse than no TTL — you'd think
# the box was cleaning itself up.
_reaper_running() {
  [ -n "$(docker --context "$CTX" ps -q --filter 'name=rdk-reaper' 2>/dev/null)" ]
}

_ttl_warn_if_no_reaper() {
  _reaper_running && return 0
  echo "⚠️  no reaper is running on this VPS — the TTL is recorded but nothing will enforce it."
  echo "    start it once per server:  rdk reaper up"
}

# --- report helpers (audit / doctor) ---------------------------------------
RDK_WARN=0; RDK_FAIL=0
_ok()   { printf "  \033[32m✔\033[0m %s\n" "$1"; }
_warn() { printf "  \033[33m⚠\033[0m %s\n" "$1"; RDK_WARN=$((RDK_WARN+1)); }
_bad()  { printf "  \033[31m✘\033[0m %s\n" "$1"; RDK_FAIL=$((RDK_FAIL+1)); }

case "$cmd" in
  connect)
    docker context create "$CTX" --docker "host=ssh://${VPS_SSH}" 2>/dev/null \
      && echo "✅ connected '$CTX' → ${VPS_SSH}" || echo "ℹ️  context '$CTX' already exists" ;;

  reaper)
    sub="${1:-up}"; [ $# -gt 0 ] && shift || true
    R=(docker --context "$CTX" compose -p rdk-reaper --project-directory "$ROOT" --env-file "$ENV_FILE" -f "$STACKS/reaper.yml")
    case "$sub" in
      up)
        ssh "${SSH_OPTS[@]}" "$VPS_SSH" "mkdir -p $TTL_DIR"
        # The socket-proxy runs unprivileged, so it needs this host's docker group to open the
        # socket. The gid is not portable across machines — read it, don't assume it.
        DOCKER_GID="$(ssh "${SSH_OPTS[@]}" "$VPS_SSH" "stat -c '%g' /var/run/docker.sock")"
        [ -n "$DOCKER_GID" ] || { echo "❌ couldn't read the docker socket gid on $VPS_SSH"; exit 1; }
        export DOCKER_GID
        "${R[@]}" up -d
        echo "✅ reaper up — expired projects will be stopped (volumes kept)"
        echo "   it reaches Docker through a default-deny socket-proxy: it may only list"
        echo "   containers and stop them. No create, no exec, no delete." ;;
      down) "${R[@]}" down ;;
      logs) "${R[@]}" logs -f ;;
      *) echo "usage: rdk reaper {up|down|logs}"; exit 1 ;;
    esac ;;

  ttl)
    arg="${1:-}"
    if [ -z "$arg" ]; then
      exp="$(_ttl_get)"
      if [ -z "$exp" ]; then
        echo "no expiry set for $PROJECT_NAME (runs until you stop it)"
      else
        now=$(ssh "${SSH_OPTS[@]}" "$VPS_SSH" 'date +%s')
        echo "$PROJECT_NAME expires in $(_fmt_left $(( exp - now )))"
        _reaper_running || _ttl_warn_if_no_reaper
      fi
      exit 0
    fi
    if [ "$arg" = "off" ]; then
      _ttl_clear; echo "✅ expiry cleared — $PROJECT_NAME runs until you stop it"; exit 0
    fi
    secs="$(_ttl_secs "$arg")" || exit 1
    _ttl_set "$secs" >/dev/null
    echo "✅ $PROJECT_NAME expires in $(_fmt_left "$secs")"
    _ttl_warn_if_no_reaper ;;

  extend)
    arg="${1:?usage: rdk extend <duration>   e.g. rdk extend 2h}"
    secs="$(_ttl_secs "$arg")" || exit 1
    _ttl_set "$secs" >/dev/null
    echo "✅ $PROJECT_NAME now expires in $(_fmt_left "$secs")"
    _ttl_warn_if_no_reaper ;;
  proxy)
    net="${PROXY_NETWORK:-web}"; sub="${1:-up}"; [ $# -gt 0 ] && shift || true
    P=(docker --context "$CTX" compose -p remote-proxy --project-directory "$ROOT" --env-file "$ENV_FILE" -f "$STACKS/traefik.yml")
    case "$sub" in
      up)   docker --context "$CTX" network create "$net" 2>/dev/null && echo "✅ net '$net'" || true; "${P[@]}" up -d && echo "✅ proxy up (80/443)";;
      down) "${P[@]}" down ;;
      *) echo "usage: rdk proxy {up|down}"; exit 1 ;;
    esac ;;
  doctor)
    echo "🩺 RDK doctor — $PROJECT_NAME"
    command -v docker >/dev/null 2>&1 && _ok "docker CLI installed" || _bad "docker CLI missing (brew install docker)"
    if ssh -o BatchMode=yes -o ConnectTimeout=8 "$VPS_SSH" 'echo ok' >/dev/null 2>&1; then
      _ok "passwordless SSH to $VPS_SSH"
    else
      _bad "SSH to $VPS_SSH is not passwordless (run: ssh-copy-id $VPS_SSH)"
    fi
    docker context inspect "$CTX" >/dev/null 2>&1 && _ok "docker context '$CTX' exists" || _warn "context '$CTX' missing — run: rdk connect"

    if [ -n "$BASE_COMPOSE" ]; then
      _ok "overlay mode — your $BASE_COMPOSE + rdk's traefik labels"
      _svcs="$(_base_services)"
      if [ -n "$_svcs" ]; then
        printf '%s\n' "$_svcs" | grep -qxF "$APP_SERVICE" \
          && _ok "APP_SERVICE=$APP_SERVICE is a real service" \
          || _bad "APP_SERVICE=$APP_SERVICE is not in $BASE_COMPOSE (have: $(echo $_svcs | tr '\n' ' '))"
      fi
    else
      [ -f "$STACK_FILE" ] && _ok "stack '$(basename "$STACK_FILE")' found" || _bad "stack file missing: $STACK_FILE"
      # The fork problem, caught early: you have your own compose file but RDK is running a
      # bundled re-implementation of it. They will drift.
      if _own="$(_detect_base)"; then
        _warn "this project has its own $_own, but RDK is running the bundled '$(basename "$STACK_FILE")'."
        _warn "  they will drift. switch with:  BASE_COMPOSE=$_own  (+ APP_SERVICE=<your web service>)"
      fi
    fi
    [ -n "${APP_HOST:-}" ] && _ok "APP_HOST=$APP_HOST" || _warn "APP_HOST not set"

    # A TTL that nothing enforces is worse than no TTL: you'd believe the box cleans itself up.
    _exp="$(_ttl_get 2>/dev/null || true)"
    if [ -n "$_exp" ]; then
      if _reaper_running; then
        _now=$(ssh "${SSH_OPTS[@]}" "$VPS_SSH" 'date +%s' 2>/dev/null || echo 0)
        _ok "expires in $(_fmt_left $(( _exp - _now ))), reaper is running"
      else
        _bad "expiry is set but NO reaper is running — nothing will stop this (rdk reaper up)"
      fi
    fi
    echo "── $RDK_FAIL failed, $RDK_WARN warnings ──"; [ "$RDK_FAIL" -eq 0 ] ;;

  audit)
    echo "🔒 RDK security audit — $PROJECT_NAME"
    # 1) local config hygiene
    if git rev-parse --git-dir >/dev/null 2>&1; then
      if git check-ignore -q "$ENV_FILE" 2>/dev/null || grep -qxF "$ENV_FILE" .git/info/exclude 2>/dev/null; then
        _ok "$ENV_FILE is gitignored (secrets won't be committed)"
      else
        _warn "$ENV_FILE is NOT gitignored — it holds SSH target + creds; add it to .gitignore"
      fi
    fi
    # 2) TLS + headers + debug exposure
    if [ -n "${APP_HOST:-}" ]; then
      url="https://$APP_HOST"
      tls=$(curl -sS -m 15 -o /dev/null -w "%{ssl_verify_result}" "$url/" 2>/dev/null || echo x)
      [ "$tls" = "0" ] && _ok "TLS certificate valid" || _bad "TLS invalid/unreachable (ssl_verify_result=$tls)"
      code=$(curl -sS -m 15 -o /dev/null -w "%{http_code}" "http://$APP_HOST/" 2>/dev/null || echo 000)
      case "$code" in 30*) _ok "HTTP redirects to HTTPS ($code)";; 000) _warn "port 80 unreachable";; *) _warn "HTTP did not redirect (got $code)";; esac
      hdrs=$(curl -sS -m 15 -D - -o /dev/null "$url/" 2>/dev/null || true)
      grep -qi "strict-transport-security" <<<"$hdrs" && _ok "HSTS header present" || _warn "no Strict-Transport-Security (HSTS) header"
      grep -qi "x-content-type-options" <<<"$hdrs" && _ok "X-Content-Type-Options present" || _warn "no X-Content-Type-Options: nosniff"
      grep -qiE "x-frame-options|content-security-policy" <<<"$hdrs" && _ok "clickjacking protection present" || _warn "no X-Frame-Options / CSP"
      body=$(curl -sS -m 15 "$url/__rdk_audit_probe_$$" 2>/dev/null || true)
      if grep -qiE "Traceback \(most recent call|you have .*DEBUG|DjangoDebug|Werkzeug Debugger" <<<"$body"; then
        _bad "DEBUG error page exposed — leaks stack traces & settings (set DEBUG=False)"
      else
        _ok "no debug/error page leaked"
      fi
    else
      _warn "APP_HOST not set — skipped remote HTTPS checks"
    fi
    # 3) no host-published ports (DB/redis must stay private, behind the proxy)
    if docker context inspect "$CTX" >/dev/null 2>&1; then
      pub=$("${COMPOSE[@]}" ps --format '{{.Name}} {{.Ports}}' 2>/dev/null | grep -oE '0\.0\.0\.0:[0-9]+|:::[0-9]+' | sort -u || true)
      [ -z "$pub" ] && _ok "no host-published ports (traffic via proxy only)" || _warn "host-published ports (should be proxy-only): $(echo "$pub" | tr '\n' ' ')"
    fi
    echo "── $RDK_FAIL failed, $RDK_WARN warnings ──"; [ "$RDK_FAIL" -eq 0 ] ;;

  vps)
    # Everything on the box, not just this project — so you can see what else is
    # sharing the VPS (and the ports/hosts already taken) before you deploy.
    echo "🛰  running on ${VPS_SSH}"
    printf "   %-26s %-34s %-9s %s\n" "PROJECT" "CONTAINER" "STATE" "URL"
    docker --context "$CTX" ps -a \
      --format '{{.Label "com.docker.compose.project"}}|{{.Names}}|{{.State}}|{{.Labels}}' \
      2>/dev/null | sort | while IFS='|' read -r proj name state labels; do
        [ -n "$proj" ] || proj="—"
        # Traefik advertises the public host in its router rule: Host(`x.example.com`)
        # `|| true`: most containers (db, redis, workers) carry no such label, and
        # under `set -e` a failing grep would otherwise abort the whole listing.
        host="$(printf '%s' "$labels" | grep -oE 'Host\(`[^`]+`\)' | head -1 | sed -E 's/Host\(`(.*)`\)/\1/' || true)"
        url=""; [ -n "$host" ] && url="https://$host"
        mine=" "; [ "$proj" = "$PROJECT_NAME" ] && mine="*"
        printf " %s %-26s %-34s %-9s %s\n" "$mine" "$proj" "$name" "$state" "$url"
      done
    echo "   (* = this project)" ;;

  up)
    # --ttl wins over TTL in .env.remote, so you can borrow the box for an hour without
    # editing config. Parse it out before compose sees the args.
    _ttl="${TTL:-}"
    _args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --ttl)   _ttl="${2:?--ttl needs a duration, e.g. --ttl 4h}"; shift 2 ;;
        --ttl=*) _ttl="${1#--ttl=}"; shift ;;
        *)       _args+=("$1"); shift ;;
      esac
    done

    # Validate the duration BEFORE building — failing after a ten-minute remote build
    # because of a typo would be its own small tragedy.
    if [ -n "$_ttl" ]; then _secs="$(_ttl_secs "$_ttl")" || exit 1; fi
    _check_app_service

    "${COMPOSE[@]}" up -d --build ${_args[@]+"${_args[@]}"}

    if [ -n "$_ttl" ]; then
      _ttl_set "$_secs" >/dev/null
      echo "⏳ $PROJECT_NAME expires in $(_fmt_left "$_secs") — then it stops (volumes kept)"
      echo "   extend any time:  rdk extend 2h        cancel:  rdk ttl off"
      _ttl_warn_if_no_reaper
    fi ;;
  watch)  _check_app_service; "${COMPOSE[@]}" up -d --build && echo "👀 syncing edits → VPS (Ctrl-C to stop)…" && "${COMPOSE[@]}" watch ;;
  down)   "${COMPOSE[@]}" down --rmi all -v "$@" ;;
  stop)   "${COMPOSE[@]}" stop "$@" ;;
  logs)   "${COMPOSE[@]}" logs -f "$@" ;;
  ps)     "${COMPOSE[@]}" ps "$@" ;;
  manage) "${COMPOSE[@]}" run --rm "$APP_SERVICE" python manage.py "$@" ;;
  sh)     "${COMPOSE[@]}" exec "$APP_SERVICE" sh ;;
  *) _usage; exit 1 ;;
esac
