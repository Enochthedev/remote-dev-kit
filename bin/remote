#!/usr/bin/env bash
# remote — build your project locally, run + test it on the VPS.
# Reads config from .env.remote (copy from .env.remote.example).
set -euo pipefail
cd "$(dirname "$0")"

ENV_FILE="${ENV_FILE:-.env.remote}"
if [ ! -f "$ENV_FILE" ]; then
  echo "❌ Missing $ENV_FILE — copy .env.remote.example to .env.remote and edit it." >&2
  exit 1
fi
set -a; source "$ENV_FILE"; set +a
: "${PROJECT_NAME:?set PROJECT_NAME in $ENV_FILE}"
: "${VPS_SSH:?set VPS_SSH in $ENV_FILE}"

CTX="remote-${PROJECT_NAME}"
STACK="${COMPOSE_FILE:-docker-compose.remote.yml}"
APP_SERVICE="${APP_SERVICE:-app}"
COMPOSE=(docker --context "$CTX" compose -p "$PROJECT_NAME" --env-file "$ENV_FILE" -f "$STACK")

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  init)
    if docker context create "$CTX" --docker "host=ssh://${VPS_SSH}" 2>/dev/null; then
      echo "✅ context '$CTX' created (→ ${VPS_SSH})"
    else
      echo "ℹ️  context '$CTX' already exists"
    fi
    ;;
  up)     "${COMPOSE[@]}" up -d --build "$@" ;;
  watch)  "${COMPOSE[@]}" up -d --build && echo "👀 syncing edits → VPS (Ctrl-C to stop)…" && "${COMPOSE[@]}" watch ;;
  down)   "${COMPOSE[@]}" down --rmi all -v "$@" ;;
  stop)   "${COMPOSE[@]}" stop "$@" ;;
  logs)   "${COMPOSE[@]}" logs -f "$@" ;;
  ps)     "${COMPOSE[@]}" ps "$@" ;;
  manage) "${COMPOSE[@]}" run --rm "$APP_SERVICE" python manage.py "$@" ;;
  sh)     "${COMPOSE[@]}" exec "$APP_SERVICE" sh ;;
  proxy)
    # Stand up the kit's own Traefik on a BARE VPS (skip if you use Coolify).
    net="${PROXY_NETWORK:-web}"
    PROXY=(docker --context "$CTX" compose -p remote-proxy --env-file "$ENV_FILE" -f docker-compose.traefik.yml)
    sub="${1:-up}"; [ $# -gt 0 ] && shift || true
    case "$sub" in
      up)
        if docker --context "$CTX" network create "$net" 2>/dev/null; then
          echo "✅ proxy network '$net' created"
        else
          echo "ℹ️  proxy network '$net' already exists"
        fi
        "${PROXY[@]}" up -d
        echo "✅ Traefik is up on the VPS (ports 80/443)."
        ;;
      down) "${PROXY[@]}" down ;;
      logs) "${PROXY[@]}" logs -f ;;
      *) echo "usage: ./remote proxy {up|down|logs}"; exit 1 ;;
    esac
    ;;
  *)
    cat <<'EOF'
remote — build locally, run on the VPS.

usage: ./remote <command> [args]
  init         create the docker context for this project (run once)
  proxy up     bare VPS only: start the kit's Traefik (run once per server)
  up           build on the VPS + deploy
  watch        deploy + live-sync your edits to the VPS (hot reload)
  down         tear down + delete images/volumes on the VPS
  stop         stop containers (keep images/volumes)
  logs         follow logs (e.g. ./remote logs django)
  ps           list running services
  manage       run manage.py (e.g. ./remote manage migrate)
  sh           open a shell in the app container

Proxy: on a bare VPS run `./remote proxy up` once. If your VPS already runs
Coolify/Traefik, set PROXY_NETWORK=coolify in .env.remote and skip that step.
EOF
    exit 1 ;;
esac
